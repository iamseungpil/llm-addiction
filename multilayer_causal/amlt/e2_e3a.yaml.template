description: multilayer-causal E2+E3a - rank-r subspace + G-axis steering at S*=L18-23 (52 arms, 4xH100, resume-safe)

target:
  service: sing
  name: msrresrchbasicvc
  workspace_name: msra-sh-aml-ws

environment:
  image: amlt-sing/acpt-torch2.7.1-py3.10-cuda12.6-ubuntu22.04

code:
  local_dir: $CONFIG_DIR/

jobs:
  - name: mlc_e2_e3a
    sku: 80G4-H100
    sla_tier: Standard
    priority: high
    identity: managed
    submit_args:
      max_run_duration_seconds: 86400
      env:
        _AZUREML_SINGULARITY_JOB_UAI: "/subscriptions/c4c534bc-9978-4974-9c87-551f7c5754ef/resourceGroups/msra-sh-aml-rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/msra-sh-aml-uai"
        HF_TOKEN: HF_TOKEN_PLACEHOLDER
        HUGGING_FACE_HUB_TOKEN: HF_TOKEN_PLACEHOLDER
    command:
      - nvidia-smi
      - |
        bash -c '
        set -x
        source /opt/conda/etc/profile.d/conda.sh
        conda activate ptca
        pip install -q "huggingface_hub<1.0" "transformers>=4.44" accelerate scipy pyyaml 2>&1 | tail -1
        mkdir -p /scratch/mlc
        cd /scratch/mlc
        export HF_HOME=/scratch/mlc/hf_cache
        python -c "
        from huggingface_hub import hf_hub_download
        import os, tarfile
        p = hf_hub_download(\"llm-addiction-research/llm-addiction\", \"experiments/multilayer_causal/code/multilayer_causal.tar.gz\", repo_type=\"dataset\", token=os.environ[\"HF_TOKEN\"])
        tarfile.open(p).extractall(\".\")
        print(\"code extracted\")
        "
        export LLM_ADDICTION_BEHAVIORAL_ROOT=/scratch/mlc/data/behavioral
        bash multilayer_causal/run_arms.sh 4 e2_r1 e2_r2 e2_r8 e2_r32 e2_r128 e3a_m20 e3a_m10 e3a_m05 e3a_a00 e3a_p05 e3a_p10 e3a_p20 e2_rnd_r1_s0 e2_rnd_r1_s1 e2_rnd_r1_s2 e2_rnd_r1_s3 e2_rnd_r1_s4 e2_rnd_r1_s5 e2_rnd_r1_s6 e2_rnd_r1_s7 e2_rnd_r1_s8 e2_rnd_r1_s9 e2_rnd_r8_s0 e2_rnd_r8_s1 e2_rnd_r8_s2 e2_rnd_r8_s3 e2_rnd_r8_s4 e2_rnd_r8_s5 e2_rnd_r8_s6 e2_rnd_r8_s7 e2_rnd_r8_s8 e2_rnd_r8_s9 e2_rnd_r32_s0 e2_rnd_r32_s1 e2_rnd_r32_s2 e2_rnd_r32_s3 e2_rnd_r32_s4 e2_rnd_r32_s5 e2_rnd_r32_s6 e2_rnd_r32_s7 e2_rnd_r32_s8 e2_rnd_r32_s9 e3a_rnd_s0 e3a_rnd_s1 e3a_rnd_s2 e3a_rnd_s3 e3a_rnd_s4 e3a_rnd_s5 e3a_rnd_s6 e3a_rnd_s7 e3a_rnd_s8 e3a_rnd_s9
        echo E2_E3A_DONE
        '
