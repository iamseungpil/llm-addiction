description: spine read sweep - all-layer paper §4.1 (indicators) + §4.3 (condition) readout, faithfully reusing fit_one_subset/GroupKFold at every layer (L22 reproduces Table 1 bit-for-bit); gemma 42 layers x {sm,ic,mw} + llama-IC 32 layers; CPU-only sklearn (run on basic VC), resume-safe via per-profile HF upload/skip. §4.2 crosstask deferred (needs phase_a all-layer wiring).

target:
  service: sing
  name: msrresrchbasicvc
  workspace_name: msra-sh-aml-ws

environment:
  image: amlt-sing/acpt-torch2.7.1-py3.10-cuda12.6-ubuntu22.04

code:
  local_dir: $CONFIG_DIR/

jobs:
  - name: spine_read
    sku: 80G4-H100
    sla_tier: Standard
    priority: high
    identity: managed
    submit_args:
      max_run_duration_seconds: 86400
      env:
        _AZUREML_SINGULARITY_JOB_UAI: "/subscriptions/c4c534bc-9978-4974-9c87-551f7c5754ef/resourceGroups/msra-sh-aml-rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/msra-sh-aml-uai"
        HF_TOKEN: HF_TOKEN_PLACEHOLDER
        HUGGING_FACE_HUB_TOKEN: HF_TOKEN_PLACEHOLDER
    command:
      - |
        bash -c '
        set -x
        source /opt/conda/etc/profile.d/conda.sh
        conda activate ptca
        pip install -q "huggingface_hub<1.0" hf_transfer scikit-learn scipy numpy 2>&1 | tail -1
        export HF_HUB_ENABLE_HF_TRANSFER=1
        export HF_HOME=/scratch/spine/hf_cache
        REPO=llm-addiction-research/llm-addiction
        mkdir -p /scratch/spine && cd /scratch/spine

        # --- code (run_spine_layer + run_spine_sweep + paper pipeline) ---
        python -c "
        from huggingface_hub import hf_hub_download
        import os, tarfile
        p = hf_hub_download(\"$$REPO\", \"experiments/spine/code/spine_src.tar.gz\", repo_type=\"dataset\", token=os.environ[\"HF_TOKEN\"])
        tarfile.open(p).extractall(\"/scratch/spine\")
        print(\"code extracted\")
        "

        # --- data: behavioral catalogs + all-layer sae_features (gemma x3 + llama IC) ---
        python -c "
        import os
        from huggingface_hub import snapshot_download
        snapshot_download(\"$$REPO\", repo_type=\"dataset\", local_dir=\"/scratch/spine/data\",
          token=os.environ[\"HF_TOKEN\"],
          allow_patterns=[
            \"behavioral/**\",
            \"sae_features_v3/slot_machine/gemma/sae_features_L*.npz\",
            \"sae_features_v3/investment_choice/gemma/sae_features_L*.npz\",
            \"sae_features_v3/mystery_wheel/gemma/sae_features_L*.npz\",
            \"sae_features_v3/investment_choice/llama/sae_features_L*.npz\",
            \"sae_features_v3/slot_machine/llama/sae_features_L*.npz\",
            \"sae_features_v3/mystery_wheel/llama/sae_features_L*.npz\",
          ])
        print(\"data pulled\")
        "

        export PYTHONUNBUFFERED=1
        cd /scratch/spine/sae_v3_analysis/src
        DROOT=/scratch/spine/data/sae_features_v3
        OUT=/scratch/spine/data/profiles
        SECS=indicators,condition

        # gemma: all 3 tasks, 42 layers
        python run_spine_sweep.py --model gemma --sections $$SECS \
          --tasks slot_machine,investment_choice,mystery_wheel --layers 0-41 \
          --data-root $$DROOT --out-dir $$OUT --hf-repo $$REPO --hf-prefix experiments/spine/profiles
        echo SPINE_GEMMA_DONE

        # llama: all 3 tasks (IC native + SM/MW from spine_extract), 32 layers
        python run_spine_sweep.py --model llama --sections $$SECS \
          --tasks investment_choice,slot_machine,mystery_wheel --layers 0-31 \
          --data-root $$DROOT --out-dir $$OUT --hf-repo $$REPO --hf-prefix experiments/spine/profiles
        echo SPINE_READ_DONE
        '
